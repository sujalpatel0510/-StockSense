# ==============================================================================
# StockSense Backend Environment Configuration
# ==============================================================================

# Port the backend server will listen on
PORT=5000

# ------------------------------------------------------------------------------
# PostgreSQL Database Connection URL
# ------------------------------------------------------------------------------
# FORMAT: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE_NAME>?schema=public
#
# Examples:
# 1. Local PostgreSQL (default user 'postgres', password 'your_password', port 5432):
#    DATABASE_URL="postgresql://postgres:your_password@localhost:5432/stocksense_db?schema=public"
#
# 2. Docker Compose setup (included in this project):
#    DATABASE_URL="postgresql://stocksense_user:stocksense_pass@localhost:5432/stocksense_db?schema=public"
#
# 3. Cloud PostgreSQL (Neon / Supabase / AWS RDS):
#    DATABASE_URL="postgresql://user:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require"
# ------------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/stocksense_db?schema=public"

# JWT Secret for authenticating users
JWT_SECRET="stocksense_super_secure_jwt_secret_key_2026_hackathon_grade"
JWT_EXPIRES_IN="7d"

# Optional: Google OAuth Client ID for Google Login / Signup
# Get one from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=""

# CORS origin (Frontend URL)
CLIENT_URL="http://localhost:5173"
